{
  "name": "intelligent-traffic-violation-detection-system",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix client && npm install --prefix server",
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix client",
    "test": "npm run test --prefix server",
    "test:e2e": "node --test tests/selenium.test.mjs",
    "start": "npm run start --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "selenium-webdriver": "^4.51.0"
  }
}
